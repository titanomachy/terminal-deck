version = "0.1.0"
author = "titanomachy"
description = "TerminalDeck: a collection of pure-Nim terminal libraries"
license = "MIT"

requires "nim >= 2.2.0"

# Foundations
requires "terminal_style >= 0.1.2"
requires "terminal_screen >= 0.1.2"

# Output components
requires "terminal_status >= 0.1.2"
requires "terminal_table >= 0.1.3"
requires "terminal_layout >= 0.1.3"
requires "terminal_graph >= 0.1.2"

# Interaction
requires "terminal_prompt >= 0.1.3"
requires "terminal_widgets >= 0.2.0"
